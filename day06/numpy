#operation speed list vs numpy array
import time
# Create a large list and a large numpy array
large_list = list(range(1000000))
large_array = np.array(large_list)
# Measure time taken to sum the list
start_time = time.time()
list_sum = sum(large_list)
end_time = time.time()
print(f"Time taken to sum the list: {end_time - start_time:.6f} seconds")
# Measure time taken to sum the numpy array
start_time = time.time()
array_sum = np.sum(large_array)
end_time = time.time()
print(f"Time taken to sum the numpy array: {end_time - start_time:.6f} seconds")

#measure the memory usage of list vs numpy array
import sys
# Measure memory usage of the list
list_memory = sys.getsizeof(large_list)
print(f"Memory usage of the list: {list_memory} bytes")
# Measure memory usage of the numpy array
array_memory = large_array.nbytes
print(f"Memory usage of the numpy array: {array_memory} bytes")

#advantages of numpy array over list
#1. Performance: Numpy arrays are optimized for performance and can be much faster than lists for large datasets.
#2. Memory Efficiency: Numpy arrays use less memory than lists because they store data in a contiguous block of memory and have a fixed data type.
#3. Functionality: Numpy provides a wide range of mathematical functions and operations that can be applied to arrays, making it easier to perform complex calculations.
#4.np_arrays are homogeneous, meaning all elements must be of the same type, which allows for more efficient storage and faster computations compared to lists that can contain heterogeneous data types.

